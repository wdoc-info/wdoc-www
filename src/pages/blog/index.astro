---
import { glob } from 'astro:content'; 
import Layout from "../../layouts/Layout.astro";

const posts = Object.values(
  import.meta.glob('./*.md', { eager: true })
);
---
<Layout title="wdoc - The Document Format, Reimagined - blog" description="Latest updates on the wdoc format">
  <h1>wdoc blog</h1>
  <ul>
    {posts.map((post: any) => (
    <li>
      <a href={post.url}>{post.frontmatter.title}</a>
      <small>{post.frontmatter.date}</small>
    </li>
    ))}
  </ul>
</Layout>